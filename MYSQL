CREATE DATABASE Collegess;

SHOW DATABASES;

USE Collegess;

CREATE TABLE student_table(
    student_ID INT PRIMARY KEY,
    student_name VARCHAR(50),
    age INT,
    gender VARCHAR(10),
    department VARCHAR(30),
    semester INT,
    city VARCHAR(30),
    cgpa DECIMAL(3,2)
);

